# Firebase Web Config
# Get these values from: Firebase Console → Project Settings → Your apps → Web app
# Add them as GitHub Actions secrets: Settings → Secrets and variables → Actions → New repository secret
# Name each secret VITE_FIREBASE_* exactly as shown below.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=match-pulse-4560e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=match-pulse-4560e
VITE_FIREBASE_STORAGE_BUCKET=match-pulse-waterpolo-f9b4c
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# The Match Pulse apps share one Firebase project; each sport has its own named
# Firestore database. Water Polo uses the `waterpolo` database. Leave unset to
# use the committed default ('waterpolo').
VITE_FIRESTORE_DATABASE=waterpolo
